# Copie ce fichier en .env.local et remplis les valeurs. Ne commit jamais .env.local.

# Supabase (étape 4.3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA (étape 4.4) — côté serveur uniquement
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL_VISION=
AI_MODEL_TEXT=
# Optionnel : modèle de secours si le quota du modèle texte est atteint (erreur 429)
AI_MODEL_TEXT_FALLBACK=

# Ville par défaut (Nantes)
NEXT_PUBLIC_DEFAULT_CITY=Nantes
NEXT_PUBLIC_DEFAULT_LAT=47.2184
NEXT_PUBLIC_DEFAULT_LON=-1.5536
